[Unit]
Description=Slingshot HSN provisioning from LLDP
Documentation=https://github.com/opencube-horizon/slingshot-netcfg
Wants=lldpd.service
After=lldpd.service systemd-udevd.service

[Service]
Type=notify
ExecStart=/usr/bin/slingshot-netcfg run
Restart=always
RestartSec=2
WatchdogSec=30s
RuntimeDirectory=slingshot-netcfg
RuntimeDirectoryPreserve=yes

# Unprivileged, with only CAP_NET_ADMIN (netlink changes and the
# /proc/sys/net sysctls); the lldpd group grants lldpcli the control socket.
# A static user (sysusers.d) rather than DynamicUser=, which would move the
# preserved runtime directory below the root-only /run/private.
User=slingshot-netcfg
Group=slingshot-netcfg
SupplementaryGroups=lldpd
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ReadWritePaths=/proc/sys/net/ipv4/conf -/proc/sys/net/ipv6/conf
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service @sandbox
SystemCallErrorNumber=EPERM
UMask=0022

[Install]
WantedBy=multi-user.target
